# Copy to config.env and edit:
#   cp config.env.example config.env
#   chmod 600 config.env

EMAIL_TO="CHANGE_ME"
EMAIL_FROM="vuln-watch@$(hostname -f)"

UBUNTU_CODENAME=""
USN_LOOKBACK_DAYS=7

# Only mail when build_email.py reports need_attention
MAIL_ONLY_ON_FINDINGS=1

# Set to 1 to write email files without sending (preview)
DRY_RUN_EMAIL=0

USE_CURSOR_AI=0
CURSOR_API_KEY=""
CURSOR_MODEL="composer-2.5"
