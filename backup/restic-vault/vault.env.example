# Copy on server: sudo cp vault.env.example /etc/restic/vault.env && sudo chmod 600 /etc/restic/vault.env

export RESTIC_PASSWORD_FILE=/etc/restic/password

# Hetzner Storage Box (enable SSH/SFTP in Console). Port 23 in root ~/.ssh/config if used.
export RESTIC_REPOSITORY='sftp:uXXXXX@uXXXXX.your-storagebox.de:8157f6c0'

# Space-separated paths (v1: local MySQL dumps from cron)
export RESTIC_BACKUP_PATHS="/home/db_backups"

# Optional retention overrides (defaults match restic-backup-vault.sh)
# export RESTIC_KEEP_DAILY=7
# export RESTIC_KEEP_WEEKLY=4
# export RESTIC_KEEP_MONTHLY=6

# export RESTIC_BACKUP_TAGS="scheduled,db"
# export RESTIC_BACKUP_HOST="bx-db"

# Set to 1 on a monthly cron run
# export RESTIC_RUN_CHECK=1
