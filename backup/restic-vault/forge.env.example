# Copy on forge: sudo cp forge.env.example /etc/restic/forge.env && sudo chmod 600 /etc/restic/forge.env

export RESTIC_PASSWORD_FILE=/etc/restic/password

# Hetzner Storage Box (enable SSH/SFTP in Console). Port is usually 23.
# Subpath ./forge-restic is created on first restic init.
export RESTIC_REPOSITORY='sftp:uXXXXX@uXXXXX.your-storagebox.de:23/./forge-restic'

# Space-separated paths (v1: local MySQL dumps from forge cron)
export RESTIC_BACKUP_PATHS="/home/db_backups"

# Optional retention overrides (defaults match restic-backup-forge.sh)
# export RESTIC_KEEP_DAILY=7
# export RESTIC_KEEP_WEEKLY=4
# export RESTIC_KEEP_MONTHLY=6

# Comma-separated restic tags
# export RESTIC_BACKUP_TAGS="forge,scheduled"

# Set to 1 on a monthly cron run
# export RESTIC_RUN_CHECK=1
